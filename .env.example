# Copy this file to .env and fill in your values
PORT=3000

# Legacy routing: absent or exactly 1 enables it. 0 or any other value disables it.
# Changing the deployed environment requires deployment adoption before cutover.
LEGACY_ROUTING_ENABLED=1

# Admin dashboard key — keep this secret, share only with operators
ADMIN_KEY=change-this-to-something-strong

# Meta Ads sync
META_ACCESS_TOKEN=    # long-lived user token or System User token (never expires)
META_AD_ACCOUNT_ID=   # your ad account ID, e.g. 1234567890 (with or without act_ prefix)
