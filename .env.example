# Copy this file to .env and fill in your values
PORT=3000

# Admin dashboard key — keep this secret, share only with operators
ADMIN_KEY=change-this-to-something-strong

# Meta Ads sync
META_ACCESS_TOKEN=    # long-lived user token or System User token (never expires)
META_AD_ACCOUNT_ID=   # your ad account ID, e.g. 1234567890 (with or without act_ prefix)

# Capture-only shadow observation. Keep disabled until hosted ingress and rollback
# are verified. The secret must be delivered by Render, never committed.
SHADOW_CAPTURE_ENABLED=0
SHADOW_CAPTURE_URL=
SHADOW_CAPTURE_SECRET=
SHADOW_COHORT_REF=
SHADOW_CAPTURE_TIMEOUT_MS=1000
